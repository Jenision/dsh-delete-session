{
  "name": "dsh-delete-session",
  "version": "1.0.0",
  "description": "为 DeepSeek Harness 提供从侧边栏菜单永久删除对话的功能",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0"
  }
}
